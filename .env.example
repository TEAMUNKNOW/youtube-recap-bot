# Telegram (required)
BOT_TOKEN=123456:ABC-DEF
API_ID=12345678
API_HASH=your_api_hash
# Optional MTProto user session for large uploads
USER_SESSION_STRING=

# Authorization (comma-separated Telegram user IDs)
OWNER_IDS=123456789
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Workspace
WORKSPACE_ROOT=/tmp/youtube_recap

# Concurrency & limits
MAX_CONCURRENT_TASKS=2
MAX_VIDEO_DURATION_MINUTES=180
MAX_INPUT_SIZE_GB=10
MAX_OUTPUT_SIZE_GB=8
TASK_TIMEOUT_SECONDS=7200
FFMPEG_TIMEOUT_SECONDS=7200

# AI keys (configure at least one LLM + optionally Groq)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# TTS
TTS_PROVIDER=edge
# If the primary provider fails, try these in order. Providers without keys are skipped.
TTS_FALLBACK_PROVIDERS=local,openai,elevenlabs
HINDI_VOICE=hi-IN-MadhurNeural
ENGLISH_VOICE=en-US-ChristopherNeural
BENGALI_VOICE=bn-IN-TanishaaNeural
SPANISH_VOICE=es-ES-AlvaroNeural

# LLM
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# YouTube OAuth
YOUTUBE_CLIENT_SECRETS=./data/client_secrets.json
YOUTUBE_TOKEN_FILE=./data/youtube_token.json
YOUTUBE_QUOTA_DAILY_BUDGET=10000
YOUTUBE_QUOTA_SAFETY_PERCENT=80

# Scheduler
TARGET_TIMEZONE=Asia/Kolkata
PEAK_START=18:00
PEAK_END=21:00

# yt-dlp network (optional)
PROXY_URL=
COOKIE_FILE=
PO_TOKEN=

# Assets
BGM_DIRECTORY=./assets/bgm
FONT_DIRECTORY=./assets/fonts

LOG_LEVEL=INFO

# Shorts Factory
SHORTS_ENABLED=true
SHORTS_DEFAULT_DURATION=60
SHORTS_DEFAULT_SPEED=1.5
SHORTS_DEFAULT_DAILY_LIMIT=3
SHORTS_MAX_DAILY_LIMIT=5
SHORTS_OUTPUT_WIDTH=1080
SHORTS_OUTPUT_HEIGHT=1920
SHORTS_MAX_PARTS=10000
SHORTS_RETENTION_DAYS=1
SHORTS_AUTO_BEST_TIME=true
SHORTS_DEFAULT_TIMEZONE=Asia/Kolkata
SHORTS_BOUNDARY_TOLERANCE_SECONDS=5
SHORTS_RENDER_CONCURRENCY=1
SHORTS_UPLOAD_CONCURRENCY=1
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
SHORTS_OAUTH_ENCRYPTION_KEY=
SHORTS_OAUTH_STATE_TTL_SECONDS=600
