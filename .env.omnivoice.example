# OmniVoice (Hindi Adult) — requires GPU host
TTS_PROVIDER=omnivoice
TTS_FALLBACK_PROVIDERS=local,edge
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_DTYPE=float16
OMNIVOICE_GENDER=male
# Optional free-form voice design override:
# OMNIVOICE_INSTRUCT=male, adult, medium pitch
# Optional voice clone:
# OMNIVOICE_REF_AUDIO=./assets/voices/hindi_adult_male.wav
# OMNIVOICE_REF_TEXT=नमस्ते, यह एक संदर्भ आवाज़ है।
# CPU only for tiny tests (very slow):
# OMNIVOICE_ALLOW_CPU=true
