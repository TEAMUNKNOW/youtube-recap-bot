[Unit]
Description=YouTube Recap Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/youtube-recap-bot
EnvironmentFile=/opt/youtube-recap-bot/.env
ExecStart=/opt/youtube-recap-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Resource limits
LimitNOFILE=65535
MemoryMax=8G

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/youtube-recap-bot/data /tmp/youtube_recap
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=youtube-recap-bot

[Install]
WantedBy=multi-user.target
